# Публичный префикс бакета Yandex Object Storage, без слэша в конце.
# Пример: https://storage.yandexcloud.net/uchebnaya-platforma/lecturers
# Если пусто, фото берутся из public/lecturers/.
VITE_PHOTOS_BASE_URL=

# Публичный URL бакета для всех картинок (lecturers, partners, home).
# Этот адрес уже используется по умолчанию, .env создавать не обязательно.
# Пустое значение переключает все картинки на локальные файлы из public/.
VITE_ASSETS_BASE_URL=https://storage.yandexcloud.net/project3-images-bloody9amer
